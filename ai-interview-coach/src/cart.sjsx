import { useSelector } from "react-redux";

function Cart() {
  const items = useSelector((store) => store.cart.items);

  return (
    <>
      <h1>Cart ({items.length})</h1>

      {items.map((item) => (
        <div key={item.id}>
          <h3>{item.name}</h3>
          <p>₹{item.price}</p>
        </div>
      ))}
    </>
  );
}

export default Cart;